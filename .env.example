# =====================================================================
# EDGAR SPACE - ENVIRONMENT VARIABLES
# Target architecture: Vercel + Next.js + Supabase (single backend platform)
#
# CARA PAKAI:
#   1. Copy file ini menjadi `.env.local` untuk development lokal.
#   2. Isi sendiri setiap value secara manual. File ini HANYA berisi
#      nama variable — tidak ada secret, password, atau key di sini.
#   3. Untuk production, isi value yang sama melalui Vercel Dashboard
#      (Project Settings → Environment Variables). Jangan copy secret
#      dari mesin lokal ke mana pun kecuali dashboard tersebut.
# =====================================================================

# --- Database (wajib) ---
# Connection string PostgreSQL Supabase (direct port 5432 atau pooler 6543).
# Prisma membaca variable ini. Jangan hardcode di source code.
# PENTING PgBouncer (Prisma 5.x): jika URL memakai Transaction Pooler
# port 6543 (wajib di Vercel Serverless), tambahkan parameter:
#   ?pgbouncer=true        (bila belum ada query param)
#   &pgbouncer=true        (bila URL sudah punya query param)
# pada DATABASE_URL di Vercel Dashboard. Tanpa ini muncul error:
#   42P05 prepared statement "s0" already exists / 08P01 bind mismatch.
# Direct 5432 tidak membutuhkan parameter tersebut.
DATABASE_URL=

# --- Supabase: public / client-safe (wajib) ---
# URL project Supabase. Dipakai browser + server.
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key Supabase. Aman dipakai di browser (terbatas RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: SERVER-ONLY (wajib di server, JANGAN expose) ---
# Service-role key. Hanya dipakai server-side (Express handlers, scripts).
# DILARANG: prefix NEXT_PUBLIC_*, import ke client component, commit ke Git,
# mencetak ke console/log, atau menempel ke chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs ---
# Development: biarkan localhost di `.env.local`.
# Production: isi dengan URL Vercel (tanpa localhost). Ketika dikosongkan,
# aplikasi otomatis memakai same-origin `/api`.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# --- Auth aplikasi (wajib) ---
# Secret untuk menandatangani JWT sesi admin. Isi string acak yang panjang.
JWT_SECRET=

# --- WhatsApp checkout ---
# Nomor WhatsApp tujuan order (format internasional tanpa +, cth. 628...).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Express dev server ---
# Port backend Express saat development lokal. Production Vercel tidak memakai ini.
PORT=

# --- Seed awal (hanya dipakai saat membuat admin pertama via prisma/seed.js) ---
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Legacy (JANGAN dipakai untuk konfigurasi baru) ---
# Neon adalah database lama dan tidak lagi digunakan setelah cutover Supabase.
# Jangan menambahkan variable Neon baru.
